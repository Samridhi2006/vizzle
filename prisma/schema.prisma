generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  firebaseUid  String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores Store[]
}

model Store {
  id        String   @id @default(cuid())
  userId    String
  storeName String
  domain    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  products         Product[]
  tryonLogs        TryonLog[]
  creditWallet     CreditWallet?
  creditTxns       CreditTransaction[]
  storeTier        StoreTier?

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  storeId   String
  keyHash   String   @unique
  keyPrefix String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  productId    String
  name         String
  brand        String
  cost         Float
  imageUrl     String
  category     String?
  sizeChartUrl String?
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tryonLogs  TryonLog[]

  @@unique([storeId, productId])
  @@index([storeId])
}

model TryonLog {
  id              String    @id @default(cuid())
  storeId         String
  vizzleProductId String?
  predictionId    String?
  mode            String
  userIdentifier  String?
  outputUrl       String?
  latencyMs       Int?
  success         Boolean
  errorCode       String?
  createdAt       DateTime  @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [vizzleProductId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, success])
  @@index([vizzleProductId])
}

// Tracks temporary Cloudinary uploads (shopper photos + try-on results).
// Cleaned up hourly by /api/cron/cleanup.
model TempAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique   // Cloudinary public_id — used for deletion
  folder    String             // "tryon-temp" | "tryon-output"
  storeId   String
  expiresAt DateTime
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt, deleted])
}

// ── Credit System ────────────────────────────────────────────────────────────

// One wallet per store — tracks current INR credit balance.
model CreditWallet {
  id        String   @id @default(cuid())
  storeId   String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Ledger of every credit/debit event for audit + history display.
model CreditTransaction {
  id                String   @id @default(cuid())
  storeId           String
  // PURCHASE | USAGE_IMAGE | USAGE_VIDEO | REFUND
  type              String
  amount            Float    // positive = credit added, negative = debit
  description       String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// One tier per store — controls rate limits.
// Default BASIC: 100 req/hr, 1000 req/day.
model StoreTier {
  id              String    @id @default(cuid())
  storeId         String    @unique
  // BASIC | GOLD | PREMIUM | ENTERPRISE
  tier            String    @default("BASIC")
  requestsPerHour Int       @default(100)
  requestsPerDay  Int       @default(1000)
  activatedAt     DateTime  @default(now())
  expiresAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
